# Copy this file to .env and fill in your values.
# Never commit .env.

# OpenAI-compatible API. Works with OpenAI, OpenRouter, Azure, or any compatible provider.
# For OpenRouter: https://openrouter.ai/keys  base_url https://openrouter.ai/api/v1  model e.g. openai/gpt-4o-mini
OPENAI_API_KEY=sk-or-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# Local Ollama fallback (used if OPENAI_API_KEY is empty/unreachable)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
